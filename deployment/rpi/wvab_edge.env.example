# Copy to deployment/rpi/wvab_edge.env or generate both device files with:
#   python tools/generate_device_secrets.py
# Never commit the populated .env file.
WVAB_OFFLINE=1
WVAB_UDP_ENCRYPT=1
WVAB_UDP_AUTH=1
WVAB_ALLOW_INSECURE_UDP=0
WVAB_UDP_PORT=9999
WVAB_UDP_KEY_HEX=
WVAB_UDP_TOKEN=
WVAB_UDP_AUTH_TTL_S=120
WVAB_UDP_HEADLESS=1
WVAB_UDP_TTS=1
WVAB_UDP_TTS_RATE=170
WVAB_UDP_LOG_PATH=wvab_udp_rpi.log
WVAB_UDP_HEALTH_PATH=wvab_udp_server_health.json
WVAB_UDP_WATCHDOG_SERVER_IDLE_S=30
WVAB_UDP_TRACKING=1
WVAB_UDP_TRACK_IOU=0.3
WVAB_UDP_TRACK_MAX_AGE_S=1.0
WVAB_UDP_TRACK_MIN_HITS=1
WVAB_WS_CONTROL=1
WVAB_WS_CONTROL_HOST=127.0.0.1
WVAB_WS_CONTROL_PORT=8765
WVAB_WS_TOKEN=
