[Unit]
Description=WVAB Raspberry Pi Edge Server
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/deployment/rpi/wvab_edge.env
Environment="WVAB_PYTHON_BIN=@PYTHON@"
ExecStart=@ROOT@/deployment/rpi/wvab_edge_start.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@ROOT@

[Install]
WantedBy=multi-user.target
